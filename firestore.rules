rules_version = '2';

// =============================================================================
// HB ŞANZIMAN — Firestore Güvenlik Kuralları
//
// ÖNEMLİ: Bu dosyanın depoda bulunması, kuralların Firebase'de YAYINDA olduğu
// anlamına GELMEZ. Deploy edilmedikleri sürece projede hangi kurallar geçerliyse
// o geçerlidir (örn. proje kurulurken seçilen test modu: "allow read, write: if true").
// Deploy adımları için dosyanın sonuna bakın.
//
// Tasarım ilkesi: Yetkilendirme SUNUCU tarafında, burada yapılır.
// İstemci koduna (app.js) güvenilmez — tarayıcıya inen her şey okunabilir ve
// değiştirilebilir. Yönetici paneli bu yüzden siteden kaldırıldı.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici: yalnızca bu doğrulanmış e-posta ile giriş yapan hesap.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'hbotomatiksanziman16@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Randevular
    // -------------------------------------------------------------------------
    match /appointments/{appointmentId} {

      // Oluşturma: giriş yapmış kullanıcı, yalnızca KENDİ adına randevu açabilir.
      // userId kontrolü önemli — aksi halde bir kullanıcı başkasının kimliğiyle
      // kayıt oluşturup o kişinin randevularını okuyabilir hale gelir.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.status == 'pending';

      // Okuma: kullanıcı yalnızca kendi randevusunu; yönetici tümünü okur.
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Güncelleme ve silme: yalnızca yönetici.
      // (Müşteri kendi randevusunu düzenleyemez/silemez — istenirse ayrıca açılır.)
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Kullanıcı profili (telefon, ad)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Yukarıda açıkça izin verilmeyen her şey REDDEDİLİR.
    // Bu blok, ileride eklenecek koleksiyonların yanlışlıkla açık kalmasını önler.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// =============================================================================
// NASIL DEPLOY EDİLİR
//
// Yöntem 1 — Firebase Console (en kolay, terminal gerekmez):
//   1. https://console.firebase.google.com adresine hbotomatiksanziman16@gmail.com
//      hesabıyla girin
//   2. "hb-sanziman" projesini seçin
//   3. Sol menü > Build > Firestore Database
//   4. Üstteki "Rules" (Kurallar) sekmesine tıklayın
//   5. Editördeki mevcut içeriğin TAMAMINI silin
//   6. Bu dosyanın içeriğini (bu yorum bloğu hariç, isterseniz dahil) yapıştırın
//   7. "Publish" (Yayınla) düğmesine basın
//   8. Üstte "Last published" tarihinin şu an olduğunu doğrulayın
//
// Yöntem 2 — Firebase CLI (terminal):
//   npm install -g firebase-tools
//   firebase login
//   firebase deploy --only firestore:rules --project hb-sanziman
//
// DEPLOY SONRASI TEST:
//   Firestore Database > Rules > "Rules Playground" (Kural Alanı)
//   - Simülasyon türü: get
//   - Konum: /appointments/testId
//   - Kimliği doğrulanmış: KAPALI  -> sonuç "Denied" olmalı
//   - Kimliği doğrulanmış: AÇIK, e-posta hbotomatiksanziman16@gmail.com
//     -> sonuç "Allowed" olmalı
// =============================================================================
