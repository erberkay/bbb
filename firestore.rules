rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Randevular koleksiyonu
    match /appointments/{appointmentId} {

      // Giriş yapmış (Google/e-posta) kullanıcı randevu oluşturabilir.
      // Telefon ve ad alanları zorunlu.
      allow create: if request.auth != null
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;

      // Kullanıcı yalnızca kendi randevusunu okuyabilir;
      // yöneticiler (admin custom claim) tüm randevuları okuyabilir.
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);

      // Durum güncelleme ve silme yalnızca yöneticiye açıktır.
      allow update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}
